# Telegram Bot Configuration

# Your bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# The chat ID of your group (use negative number for groups)
# To get chat ID: Add bot to group, send a message, then visit:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
CHAT_ID=-1001234567890

# The message thread ID (topic ID)
# To get thread ID: Right-click on topic, copy link, the number after /topic/ is the thread ID
MESSAGE_THREAD_ID=1

# Cron schedule for sending messages (default: 9 AM daily)
# Format: minute hour day month weekday
# Examples:
#   0 9 * * *        = Every day at 9 AM
#   0 */6 * * *      = Every 6 hours
#   0 9 * * 1        = Every Monday at 9 AM
#   */30 * * * *     = Every 30 minutes
CRON_SCHEDULE=0 9 * * *

# Path to the markdown file with daily reflections
# The file should have headers in format: ## MM-DD (e.g., ## 01-15 for January 15)
FILE_PATH=files/daily_reflections_structured.md

# Fallback message to send if reflection for today cannot be found
MESSAGE=Hello from your scheduled bot!
